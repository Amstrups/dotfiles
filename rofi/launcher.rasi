configuration {
	/* modes: "drun,window,filebrowser,recursivebrowser,ssh,run"; */
	modes: "drun,window,ssh,run";
  show-icons: true;
  /* hover-select: true; */
	sidebar-mode: true;
	tokenise: true;
}

* {
  font: "JetBrainsMono Nerd Font 12";

  bg:     #0f1115;
  bg-alt: #161a21;
  text:   #e7e7e7;
  muted:  #aab0ba;

  border: #4a5160;
  select: #20242d;

  spacing: 10;

	background-color: transparent;

	text-color: @text;
}

window {
  location: center;
  anchor: center;
  width: 920px;

  background-color: rgba(24, 24, 24, 0.96);
  border: 2px;
  border-color: @border;
  border-radius: 1px;
}

mainbox {
  orientation: vertical;
  spacing: 14px;
  padding: 18px;
  background-color: transparent;
}

/* Begin: Input bar */
inputbar {
	children:   [ "prompt","entry","overlay","num-filtered-rows","textbox-num-sep","num-rows","case-indicator" ];
  background-color: @bg-alt;
  border-color: transparent;
  padding: 12px 14px;
  spacing: 10px;
}

prompt {
  background-color: transparent;
  text-color: @muted;
}

entry {
  background-color: transparent;
  text-color: @text;
  placeholder: "Search...";
  placeholder-color: rgba(231,231,231,0.35);
}

num-filtered-rows {
	expand:     false;
	text-color: Gray;
}

num-rows {
	expand:     false;
	text-color: Gray;
}

textbox-num-sep {
	expand:     false;
	str:        "/";
	text-color: Gray;
}

case-indicator {
	spacing:    10;
	text-color: @text; 
}
/* End: Input bar */


listview {
  background-color: transparent;

  columns: 1;
  lines: 10;

  spacing: 10;
  cycle: true;
  dynamic: false;
  scrollbar: true;

  layout: vertical;
  fixed-columns: true;
  fixed-height: true;
}

element {
  orientation: horizontal;
  children: [ element-icon, element-text ];

  background-color: transparent;
  border: 1px;
  border-color: transparent;
  border-radius: 1px;

  padding: 8px 14px;
  spacing: 8px;
}

element selected {
  background-color: @select;
  border-color: @border;
  border: 2px;
}

element-icon {
  size: 32px;

	vertical-align: 0.5;

  background-color: transparent;
}

element-text {
	padding: 0px 8px;
	vertical-align: 0.5;

  text-color: @muted;
  background-color: transparent;
}

element selected element-text {
  text-color: @text;
}

element-text highlight {
	text-color: @text;
}

button {
	cursor:     pointer;
	spacing:    0;
	text-color: @muted;
	background-color: transparent;
}

button selected {
	background-color: @select;
}

